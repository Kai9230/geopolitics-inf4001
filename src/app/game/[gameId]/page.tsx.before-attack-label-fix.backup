"use client";

import {
  useCallback,
  useEffect,
  useReducer,
  useRef,
  useState,
} from "react";

import Image from "next/image";
import Link from "next/link";
import { useParams } from "next/navigation";

import {
  onAuthStateChanged,
  type User,
} from "firebase/auth";

import {
  collection,
  doc,
  onSnapshot,
  orderBy,
  query,
} from "firebase/firestore";

import { auth, db } from "@/lib/firebase/config";
import { CampaignClient } from "@/lib/api/CampaignClient";
import { MusicPlayer } from "@/lib/audio/MusicPlayer";
import { SoundEngine } from "@/lib/audio/SoundEngine";

import { RiskMap } from "@/components/game/RiskMap";
import { BattleScene } from "@/components/game/BattleScene";
import { BattleTimeline } from "@/components/game/BattleTimeline";
import { RollingDice } from "@/components/game/RollingDice";

import {
  getFactionColor,
  type MapBattleAnimation,
} from "@/components/game/MapTypes";

import type { Country } from "@/types";

import type {
  CampaignAction,
  CampaignEvent,
  CampaignState,
} from "@/types/game-state";

import styles from "@/styles/Campaign.module.css";

/* -------------------------------------------------------
 * Types
 * ----------------------------------------------------- */

interface HistoryEvent {
  revision: number;
  actorId: string;
  action: string;
  message: string;
  createdAt: number;

  dice: CampaignEvent["dice"];

  reason: string | null;
  fromId: string | null;
  toId: string | null;

  afterState: CampaignState;
}

interface Playback {
  event: HistoryEvent;
  beforeState: CampaignState;
  animation: MapBattleAnimation;
}

interface PresentationState {
  live: CampaignState | null;
  events: HistoryEvent[];
  cursor: number | null;
  playback: Playback | null;
  replayRevision: number | null;
  replayPlaying: boolean;
}

type PresentationAction =
  | {
      type: "campaign-received";
      state: CampaignState;
    }
  | {
      type: "history-received";
      events: HistoryEvent[];
    }
  | {
      type: "battle-finished";
      revision: number;
    }
  | {
      type: "select-history";
      revision: number | null;
    }
  | {
      type: "toggle-history-playback";
    }
  | {
      type: "advance-history";
    };

const INITIAL_PRESENTATION: PresentationState = {
  live: null,
  events: [],
  cursor: null,
  playback: null,
  replayRevision: null,
  replayPlaying: false,
};

/* -------------------------------------------------------
 * Map and animation helpers
 * ----------------------------------------------------- */

function mapCountries(
  state: CampaignState,
): Country[] {
  return state.countries.map((country) => ({
    id: country.id,
    name: country.name,
    flag: country.flag,
    soldiers: country.soldiers,
    ownerId: country.ownerId,
    isPlayer: country.ownerId === "human",
    x: country.x,
    y: country.y,
  }));
}

function makeAnimation(
  event: HistoryEvent,
  beforeState: CampaignState,
  active: boolean,
): MapBattleAnimation | null {
  if (
    !event.dice ||
    !event.fromId ||
    !event.toId
  ) {
    return null;
  }

  const countries = mapCountries(beforeState);

  const attacker = countries.find(
    (country) => country.id === event.fromId,
  );

  const defender = countries.find(
    (country) => country.id === event.toId,
  );

  if (!attacker || !defender) {
    return null;
  }

  return {
    id: event.revision,
    fromId: attacker.id,
    toId: defender.id,
    active,
    attackerColor: getFactionColor(attacker),
    defenderColor: getFactionColor(defender),

    dice: {
      attacker: event.dice.attacker,
      defender: event.dice.defender,
      attackerLoss: event.dice.attackerLosses,
      defenderLoss: event.dice.defenderLosses,
    },
  };
}

/* -------------------------------------------------------
 * Presentation reducer
 *
 * Saved events determine the board and battle results.
 * This reducer never generates dice or saves game moves.
 * ----------------------------------------------------- */

function processEventQueue(
  model: PresentationState,
): PresentationState {
  if (
    model.cursor === null ||
    model.playback !== null ||
    model.replayRevision !== null
  ) {
    return model;
  }

  let cursor = model.cursor;

  for (const event of model.events) {
    if (event.revision <= cursor) {
      continue;
    }

    const previous = [...model.events]
      .reverse()
      .find(
        (candidate) =>
          candidate.revision <= cursor,
      );

    const beforeState =
      previous?.afterState ?? event.afterState;

    const animation = makeAnimation(
      event,
      beforeState,
      true,
    );

    if (animation) {
      return {
        ...model,
        cursor,
        playback: {
          event,
          beforeState,
          animation,
        },
      };
    }

    cursor = event.revision;
  }

  if (cursor === model.cursor) {
    return model;
  }

  return {
    ...model,
    cursor,
  };
}

function presentationReducer(
  model: PresentationState,
  action: PresentationAction,
): PresentationState {
  switch (action.type) {
    case "campaign-received": {
      return processEventQueue({
        ...model,
        live: action.state,
      });
    }

    case "history-received": {
      const events = [...action.events].sort(
        (a, b) => a.revision - b.revision,
      );

      if (model.cursor === null) {
        const latest = events[events.length - 1];

        return {
          ...model,
          events,
          cursor: latest?.revision ?? null,
        };
      }

      return processEventQueue({
        ...model,
        events,
      });
    }

    case "battle-finished": {
      if (
        model.playback?.event.revision !==
        action.revision
      ) {
        return model;
      }

      return processEventQueue({
        ...model,
        cursor: action.revision,
        playback: null,
      });
    }

    case "select-history": {
      if (model.playback !== null) {
        return model;
      }

      if (
        action.revision !== null &&
        !model.events.some(
          (event) =>
            event.revision === action.revision,
        )
      ) {
        return model;
      }

      return processEventQueue({
        ...model,
        replayRevision: action.revision,
        replayPlaying: false,
      });
    }

    case "toggle-history-playback": {
      if (
        model.playback !== null ||
        model.events.length === 0
      ) {
        return model;
      }

      if (model.replayPlaying) {
        return {
          ...model,
          replayPlaying: false,
        };
      }

      const latest =
        model.events[model.events.length - 1];

      const startAgain =
        model.replayRevision === null ||
        model.replayRevision === latest.revision;

      return {
        ...model,
        replayRevision: startAgain
          ? model.events[0].revision
          : model.replayRevision,
        replayPlaying: true,
      };
    }

    case "advance-history": {
      if (
        !model.replayPlaying ||
        model.replayRevision === null
      ) {
        return model;
      }

      const index = model.events.findIndex(
        (event) =>
          event.revision === model.replayRevision,
      );

      const next = model.events[index + 1];

      if (!next) {
        return {
          ...model,
          replayPlaying: false,
        };
      }

      return {
        ...model,
        replayRevision: next.revision,
      };
    }
  }
}

/* -------------------------------------------------------
 * Reinforcement allocation
 * ----------------------------------------------------- */

interface ReinforcementFormProps {
  state: CampaignState;
  enabled: boolean;

  onAllocate: (
    allocations: Record<string, number>,
  ) => void;
}

function ReinforcementForm({
  state,
  enabled,
  onAllocate,
}: ReinforcementFormProps) {
  const [allocations, setAllocations] = useState<
    Record<string, number>
  >({});

  const owned = state.countries.filter(
    (country) => country.ownerId === "human",
  );

  const total = Object.values(allocations).reduce(
    (sum, amount) => sum + amount,
    0,
  );

  return (
    <section className={styles.panel}>
      <h2>Allocate reinforcements</h2>

      <p className={styles.muted}>
        Place exactly {state.pendingReinforcements} new
        soldiers among your countries.
      </p>

      <form
        className={styles.form}
        onSubmit={(event) => {
          event.preventDefault();
          onAllocate(allocations);
        }}
      >
        <fieldset
          disabled={!enabled}
          className={styles.form}
        >
          <div className={styles.allocationGrid}>
            {owned.map((country) => (
              <label key={country.id}>
                {country.name}

                <input
                  type="number"
                  min={0}
                  max={state.pendingReinforcements}
                  step={1}
                  value={allocations[country.id] ?? 0}
                  onChange={(event) => {
                    const amount = Number(
                      event.target.value,
                    );

                    setAllocations((previous) => ({
                      ...previous,
                      [country.id]: amount,
                    }));
                  }}
                />
              </label>
            ))}
          </div>

          <p className={styles.muted}>
            Allocated: {total} /{" "}
            {state.pendingReinforcements}
          </p>

          <button
            type="submit"
            className={styles.primary}
            disabled={
              total !== state.pendingReinforcements
            }
          >
            Confirm allocation
          </button>
        </fieldset>
      </form>
    </section>
  );
}

/* -------------------------------------------------------
 * Route wrapper
 *
 * A different campaign ID mounts a fresh screen.
 * ----------------------------------------------------- */

export default function GamePage() {
  const params = useParams();

  const routeId = params.gameId;

  const gameId =
    typeof routeId === "string"
      ? routeId
      : Array.isArray(routeId)
        ? routeId[0]
        : "";

  if (!gameId) {
    return (
      <main className={styles.shell}>
        <p className={styles.error}>
          Invalid campaign link.
        </p>

        <Link
          href="/lobby"
          className={styles.link}
        >
          Return to the war room
        </Link>
      </main>
    );
  }

  return (
    <CampaignScreen
      key={`campaign-${gameId}`}
      gameId={gameId}
    />
  );
}

/* -------------------------------------------------------
 * Main campaign screen
 * ----------------------------------------------------- */

function CampaignScreen({
  gameId,
}: {
  gameId: string;
}) {
  const [model, dispatch] = useReducer(
    presentationReducer,
    INITIAL_PRESENTATION,
  );

  const {
    live,
    events,
    cursor,
    playback,
    replayRevision,
    replayPlaying,
  } = model;

  const [user, setUser] = useState<User | null>(null);
  const [authReady, setAuthReady] = useState(false);

  const [busy, setBusy] = useState(false);
  const [fast, setFast] = useState(false);
  const [npcPaused, setNpcPaused] = useState(false);

  const [error, setError] = useState("");
  const [fatal, setFatal] = useState("");
  const [shareMessage, setShareMessage] = useState("");

  const [fromId, setFromId] = useState("");
  const [toId, setToId] = useState("");

  const [transferFrom, setTransferFrom] = useState("");
  const [transferTo, setTransferTo] = useState("");

  const [transferAmount, setTransferAmount] =
    useState(1);

  const mounted = useRef(true);
  const inFlight = useRef(false);

  const unlockTimer = useRef<
    ReturnType<typeof setTimeout> | null
  >(null);

  /* -----------------------------------------------------
   * Mount and cleanup
   * --------------------------------------------------- */

  useEffect(() => {
    mounted.current = true;

    return () => {
      mounted.current = false;

      if (unlockTimer.current) {
        clearTimeout(unlockTimer.current);
      }

      MusicPlayer.setScene("silent");
    };
  }, []);

  /* -----------------------------------------------------
   * Authentication subscription
   * --------------------------------------------------- */

  useEffect(() => {
    return onAuthStateChanged(
      auth,

      (nextUser) => {
        setUser(nextUser);
        setAuthReady(true);
      },

      (failure) => {
        console.error(
          "Authentication listener failed:",
          failure.message,
        );

        setUser(null);
        setAuthReady(true);

        setError(
          "Could not verify your sign-in session. " +
            "Please refresh or sign in again.",
        );
      },
    );
  }, []);

  /* -----------------------------------------------------
   * Campaign and history subscriptions
   * --------------------------------------------------- */

  useEffect(() => {
    let active = true;

    const stopCampaign = onSnapshot(
      doc(db, "campaigns", gameId),

      (snapshot) => {
        if (!active) return;

        if (!snapshot.exists()) {
          setFatal(
            "This campaign does not exist in the " +
              "new campaign system.",
          );

          return;
        }

        const state = snapshot.data().state as
          | CampaignState
          | undefined;

        if (
          !state ||
          state.schemaVersion !== 1 ||
          state.id !== gameId ||
          !Array.isArray(state.countries) ||
          state.countries.length !== 10
        ) {
          setFatal(
            "This campaign has an unsupported format.",
          );

          return;
        }

        dispatch({
          type: "campaign-received",
          state,
        });
      },

      (failure) => {
        if (!active) return;

        console.error(
          "Campaign listener failed:",
          failure.code,
        );

        setFatal(
          "Could not open the campaign. Check your " +
            "connection and the published Firestore rules.",
        );
      },
    );

    const historyQuery = query(
      collection(
        db,
        "campaigns",
        gameId,
        "events",
      ),
      orderBy("revision", "asc"),
    );

    const stopEvents = onSnapshot(
      historyQuery,

      (snapshot) => {
        if (!active) return;

        const history = snapshot.docs
          .map(
            (item) =>
              item.data() as HistoryEvent,
          )
          .filter(
            (event) =>
              Number.isSafeInteger(event.revision) &&
              event.afterState?.schemaVersion === 1,
          );

        dispatch({
          type: "history-received",
          events: history,
        });
      },

      (failure) => {
        if (!active) return;

        console.error(
          "History listener failed:",
          failure.code,
        );

        setFatal(
          "Could not load campaign events. Check " +
            "the published Firestore rules.",
        );
      },
    );

    return () => {
      active = false;

      stopCampaign();
      stopEvents();
    };
  }, [gameId]);

  const isOwner =
    authReady &&
    user !== null &&
    live !== null &&
    user.uid === live.playerId;

  /* -----------------------------------------------------
   * Battle audio
   * --------------------------------------------------- */

  useEffect(() => {
    if (!playback) {
      MusicPlayer.setScene("silent");
      return;
    }

    const humanAttack =
      playback.event.actorId === "human";

    MusicPlayer.setScene(
      isOwner && humanAttack
        ? "battle"
        : "silent",
    );

    SoundEngine.diceRoll();

    return () => {
      MusicPlayer.setScene("silent");
    };
  }, [playback, isOwner]);

  /* -----------------------------------------------------
   * Submit an action through the server
   * --------------------------------------------------- */

  const send = useCallback(
    async (
      action?: CampaignAction,
    ): Promise<void> => {
      if (
        !live ||
        auth.currentUser?.uid !== live.playerId ||
        inFlight.current
      ) {
        return;
      }

      inFlight.current = true;

      setBusy(true);
      setError("");

      try {
        if (action) {
          await CampaignClient.act(live, action);
        } else {
          await CampaignClient.advanceNpc(live);
        }

        /*
         * The subscriptions receive the saved result.
         * Do not generate a second local outcome.
         */
      } catch (failure) {
        if (!mounted.current) return;

        setError(
          failure instanceof Error
            ? failure.message
            : "The move could not be completed.",
        );

        if (!action) {
          setNpcPaused(true);
        }
      } finally {
        if (mounted.current) {
          unlockTimer.current = setTimeout(() => {
            inFlight.current = false;

            if (mounted.current) {
              setBusy(false);
            }
          }, 350);
        }
      }
    },
    [live],
  );

  const caughtUp =
    live !== null &&
    cursor !== null &&
    cursor === live.revision &&
    playback === null;

  const currentActorId = live
    ? live.turnOrder[live.turnIndex]
    : "";

  const currentParticipant =
    live?.participants.find(
      (participant) =>
        participant.id === currentActorId,
    );

  /* -----------------------------------------------------
   * NPC simulation
   * --------------------------------------------------- */

  useEffect(() => {
    if (
      !live ||
      !isOwner ||
      !caughtUp ||
      busy ||
      npcPaused ||
      replayRevision !== null ||
      live.status !== "active" ||
      currentParticipant?.kind !== "npc"
    ) {
      return;
    }

    const timer = setTimeout(
      () => void send(),
      fast ? 450 : 1100,
    );

    return () => clearTimeout(timer);
  }, [
    live,
    isOwner,
    caughtUp,
    busy,
    npcPaused,
    replayRevision,
    currentParticipant?.kind,
    fast,
    send,
  ]);

  /* -----------------------------------------------------
   * Recorded history playback
   * --------------------------------------------------- */

  useEffect(() => {
    if (
      !replayPlaying ||
      replayRevision === null
    ) {
      return;
    }

    const timer = setTimeout(() => {
      dispatch({
        type: "advance-history",
      });
    }, 1500);

    return () => clearTimeout(timer);
  }, [
    replayPlaying,
    replayRevision,
  ]);

  /* -----------------------------------------------------
   * Derived interface data
   * --------------------------------------------------- */

  const replayEvent =
    replayRevision === null
      ? undefined
      : events.find(
          (event) =>
            event.revision === replayRevision,
        );

  const cursorEvent = events.find(
    (event) => event.revision === cursor,
  );

  const viewState =
    replayEvent?.afterState ??
    playback?.beforeState ??
    cursorEvent?.afterState ??
    live;

  const visibleCountries = viewState
    ? mapCountries(viewState)
    : [];

  const owned =
    live?.countries.filter(
      (country) =>
        country.ownerId === "human",
    ) ?? [];

  const enemies =
    live?.countries.filter(
      (country) =>
        country.ownerId !== "human",
    ) ?? [];

  const canAct =
    isOwner &&
    caughtUp &&
    !busy &&
    replayRevision === null &&
    live?.status === "active" &&
    currentParticipant?.kind === "human";

  const readyToCommand =
    canAct &&
    live?.pendingReinforcements === 0;

  const canSelectAttack =
    readyToCommand &&
    !live?.activeAttack &&
    !live?.attackUsed;

  const selectedTransferSource = owned.find(
    (country) =>
      country.id === transferFrom,
  );

  const latestDiceEvent = [...events]
    .reverse()
    .find(
      (event) =>
        event.dice !== null &&
        event.revision <= (cursor ?? -1),
    );

  const idleBattleEvent =
    replayRevision !== null
      ? replayEvent?.dice
        ? replayEvent
        : undefined
      : latestDiceEvent;

  const idleBeforeState = idleBattleEvent
    ? [...events]
        .reverse()
        .find(
          (event) =>
            event.revision <
            idleBattleEvent.revision,
        )?.afterState ??
      idleBattleEvent.afterState
    : null;

  const idleAnimation =
    idleBattleEvent && idleBeforeState
      ? makeAnimation(
          idleBattleEvent,
          idleBeforeState,
          false,
        )
      : null;

  const shownAnimation =
    playback?.animation ?? idleAnimation;

  const shownBattleEvent =
    playback?.event ?? idleBattleEvent;

  const battleCountries = playback
    ? mapCountries(playback.beforeState)
    : idleBeforeState
      ? mapCountries(idleBeforeState)
      : visibleCountries;

  const visibleHumanCountries =
    viewState?.countries.filter(
      (country) =>
        country.ownerId === "human",
    ) ?? [];

  const visibleHumanSoldiers =
    visibleHumanCountries.reduce(
      (sum, country) =>
        sum + country.soldiers,
      0,
    );

  const participantsRemaining = viewState
    ? new Set(
        viewState.countries.map(
          (country) => country.ownerId,
        ),
      ).size
    : 0;

  /* -----------------------------------------------------
   * Interface handlers
   * --------------------------------------------------- */

  function selectCountry(id: string): void {
    if (!canSelectAttack || !live) {
      return;
    }

    const country = live.countries.find(
      (item) => item.id === id,
    );

    if (!country) return;

    if (country.ownerId === "human") {
      setFromId(country.id);
    } else {
      setToId(country.id);
    }
  }

  async function copyLink(): Promise<void> {
    const url =
      `${window.location.origin}/game/${gameId}`;

    try {
      await navigator.clipboard.writeText(url);
      setShareMessage("Campaign link copied.");
    } catch {
      setShareMessage(
        "Copy the campaign address from your " +
          "browser's address bar.",
      );
    }
  }

  /* -----------------------------------------------------
   * Error and loading screens
   * --------------------------------------------------- */

  if (fatal) {
    return (
      <main className={styles.shell}>
        <div className={styles.content}>
          <p
            className={styles.error}
            role="alert"
          >
            {fatal}
          </p>

          <Link
            href="/lobby"
            className={styles.link}
          >
            Return to the war room
          </Link>
        </div>
      </main>
    );
  }

  if (
    !live ||
    !viewState ||
    cursor === null
  ) {
    return (
      <main className={styles.shell}>
        <p>
          Loading the campaign and its saved history…
        </p>
      </main>
    );
  }

  const winner = viewState.participants.find(
    (participant) =>
      participant.id === viewState.winnerId,
  );

  /* -----------------------------------------------------
   * Main interface
   * --------------------------------------------------- */

  return (
    <main className={styles.shell}>
      <div className={styles.content}>
        <header className={styles.header}>
          <div>
            <p className={styles.eyebrow}>
              GeoPolitics · World command
            </p>

            <h1 className={styles.title}>
              Round {viewState.round}
            </h1>

            <p className={styles.muted}>
              {replayRevision !== null
                ? `History · Event ${replayRevision}`
                : live.status === "completed"
                  ? "Campaign complete"
                  : `${
                      currentParticipant?.name ??
                      "Participant"
                    }'s turn`}
            </p>
          </div>

          <div className={styles.toolbar}>
            <Link
              href="/lobby"
              className={styles.link}
            >
              War room
            </Link>

            <button
              type="button"
              onClick={() => void copyLink()}
            >
              Share campaign
            </button>

            <button
              type="button"
              aria-pressed={fast}
              onClick={() =>
                setFast((value) => !value)
              }
            >
              NPC speed: {fast ? "2.5×" : "1×"}
            </button>
          </div>
        </header>

        {shareMessage && (
          <p
            className={styles.notice}
            role="status"
          >
            {shareMessage}
          </p>
        )}

        {error && (
          <div
            className={styles.error}
            role="alert"
          >
            <p>{error}</p>

            {npcPaused && (
              <button
                type="button"
                onClick={() => {
                  setError("");
                  setNpcPaused(false);
                }}
              >
                Retry NPC simulation
              </button>
            )}
          </div>
        )}

        {!isOwner && authReady && (
          <div className={styles.notice}>
            Spectator mode: you can watch the board
            and history, but cannot submit moves.

            {!user && (
              <>
                {" "}
                <Link
                  href="/"
                  className={styles.link}
                >
                  Sign in to start your own campaign
                </Link>
              </>
            )}
          </div>
        )}

        {isOwner &&
          owned.length === 0 &&
          live.status === "active" && (
            <p className={styles.notice}>
              You have been eliminated. You can
              continue watching the remaining
              nations compete.
            </p>
          )}

        {viewState.status === "completed" && (
          <p
            className={styles.success}
            role="status"
          >
            {viewState.winnerId === "human"
              ? "World conquered. Your campaign is victorious."
              : `${
                  winner?.name ?? "An NPC"
                } controls all ten countries.`}
          </p>
        )}

        {replayRevision !== null && (
          <p className={styles.notice}>
            Viewing recorded history. Gameplay
            controls and owner-driven NPC simulation
            are paused in this tab until you return
            to live play.
          </p>
        )}

        {isOwner &&
          live.status === "active" &&
          currentParticipant?.kind === "npc" &&
          replayRevision === null && (
            <p
              className={styles.notice}
              role="status"
            >
              NPC turns are being simulated.
              Your controls become available when
              your turn begins. Use NPC speed to
              accelerate the visible moves.
            </p>
          )}

        <section
          className={styles.stats}
          aria-label="Campaign statistics"
        >
          <div className={styles.stat}>
            <span>Your countries</span>
            <strong>
              {visibleHumanCountries.length}/10
            </strong>
          </div>

          <div className={styles.stat}>
            <span>Your soldiers</span>
            <strong>
              {visibleHumanSoldiers}
            </strong>
          </div>

          <div className={styles.stat}>
            <span>Participants remaining</span>
            <strong>
              {participantsRemaining}
            </strong>
          </div>

          <div className={styles.stat}>
            <span>Difficulty</span>
            <strong>
              {viewState.difficulty}
            </strong>
          </div>
        </section>

        <nav
          className={styles.countryGrid}
          aria-label="All countries and soldier counts"
        >
          {visibleCountries.map((country) => (
            <button
              key={`country-${country.id}`}
              type="button"
              className={[
                styles.countryCard,

                fromId === country.id ||
                toId === country.id
                  ? styles.selected
                  : "",
              ].join(" ")}
              style={{
                borderBottom:
                  `3px solid ${getFactionColor(country)}`,
              }}
              aria-label={
                `${country.name}: ` +
                `${country.soldiers} soldiers; ` +
                (country.isPlayer
                  ? "your country"
                  : "opponent")
              }
              aria-disabled={!canSelectAttack}
              onClick={() =>
                selectCountry(country.id)
              }
            >
              <Image
                src={
                  "https://flagcdn.com/w80/" +
                  `${country.id.toLowerCase()}.png`
                }
                alt=""
                width={25}
                height={17}
                unoptimized
                className={styles.flag}
              />

              <span>
                {country.name}

                <small>
                  {country.isPlayer
                    ? "Your control"
                    : "Opponent"}
                </small>
              </span>

              <strong>
                {country.soldiers}
              </strong>
            </button>
          ))}
        </nav>

        <div className={styles.warLayout}>
          <div className={styles.mapWrap}>
            <RiskMap
              countries={visibleCountries}
              selectedAtk={
                canSelectAttack
                  ? fromId || null
                  : null
              }
              targetId={
                canSelectAttack
                  ? toId || null
                  : null
              }
              onCountryClick={selectCountry}
              battleAnimation={
                playback?.animation ?? null
              }
            />

            {playback && (
              <BattleTimeline
                key={
                  `timeline-${playback.event.revision}`
                }
                battleId={
                  playback.event.revision
                }
                fast={
                  playback.event.actorId !==
                    "human" && fast
                }
                onImpact={() => {
                  const dice =
                    playback.event.dice;

                  if (
                    dice &&
                    dice.attackerLosses +
                      dice.defenderLosses >
                      0
                  ) {
                    SoundEngine.explosion();
                  }
                }}
                onComplete={() => {
                  dispatch({
                    type: "battle-finished",
                    revision:
                      playback.event.revision,
                  });
                }}
              />
            )}

            {shownAnimation &&
              shownBattleEvent &&
              (shownBattleEvent.actorId ===
              "human" ? (
                <BattleScene
                  key={
                    `human-battle-${shownAnimation.id}`
                  }
                  animation={shownAnimation}
                  countries={battleCountries}
                />
              ) : (
                <section
                  key={
                    `npc-battle-${shownAnimation.id}`
                  }
                  data-battle-id={
                    shownAnimation.id
                  }
                  className={
                    shownAnimation.active
                      ? "is-running"
                      : "is-resolved"
                  }
                >
                  <p className={styles.muted}>
                    NPC battle · Recorded dice results
                  </p>

                  {shownAnimation.dice && (
                    <RollingDice
                      dice={
                        shownAnimation.dice
                      }
                    />
                  )}
                </section>
              ))}

            {isOwner && (
              <div className={styles.controlGrid}>
                <section className={styles.panel}>
                  <h2>Attack command</h2>

                  {live.activeAttack ? (
                    <div className={styles.stack}>
                      <p className={styles.muted}>
                        Your attack is active.
                        Roll another exchange against
                        the same target, or stop and
                        end your turn.
                      </p>

                      <button
                        type="button"
                        className={styles.primary}
                        disabled={!readyToCommand}
                        onClick={() =>
                          void send({
                            type: "roll",
                          })
                        }
                      >
                        Roll battle dice
                      </button>

                      <button
                        type="button"
                        className={styles.danger}
                        disabled={!readyToCommand}
                        onClick={() =>
                          void send({
                            type: "stop-attack",
                          })
                        }
                      >
                        Stop attack and end turn
                      </button>
                    </div>
                  ) : (
                    <form
                      className={styles.form}
                      onSubmit={(event) => {
                        event.preventDefault();

                        void send({
                          type: "start-attack",
                          fromId,
                          toId,
                        });
                      }}
                    >
                      <fieldset
                        disabled={!canSelectAttack}
                        className={styles.form}
                      >
                        <label>
                          Attack from

                          <select
                            value={fromId}
                            onChange={(event) =>
                              setFromId(
                                event.target.value,
                              )
                            }
                          >
                            <option value="">
                              Choose your country
                            </option>

                            {owned
                              .filter(
                                (country) =>
                                  country.soldiers >= 2,
                              )
                              .map((country) => (
                                <option
                                  key={country.id}
                                  value={country.id}
                                >
                                  {country.name}
                                  {" · "}
                                  {country.soldiers}
                                  {" soldiers"}
                                </option>
                              ))}
                          </select>
                        </label>

                        <label>
                          Target

                          <select
                            value={toId}
                            onChange={(event) =>
                              setToId(
                                event.target.value,
                              )
                            }
                          >
                            <option value="">
                              Choose an opponent
                            </option>

                            {enemies.map((country) => (
                              <option
                                key={country.id}
                                value={country.id}
                              >
                                {country.name}
                                {" · "}
                                {country.soldiers}
                                {" soldiers"}
                              </option>
                            ))}
                          </select>
                        </label>

                        <button
                          type="submit"
                          className={styles.primary}
                          disabled={
                            !fromId || !toId
                          }
                        >
                          Begin attack
                        </button>
                      </fieldset>

                      <button
                        type="button"
                        disabled={!readyToCommand}
                        onClick={() =>
                          void send({
                            type: "end-turn",
                          })
                        }
                      >
                        {live.attackUsed
                          ? "Finish turn"
                          : "Skip attack and end turn"}
                      </button>
                    </form>
                  )}
                </section>

                <section className={styles.panel}>
                  <h2>Transfer soldiers</h2>

                  <p className={styles.muted}>
                    Transfer between two countries
                    you own when no attack is active.
                    Leave at least one soldier behind.
                  </p>

                  <form
                    className={styles.form}
                    onSubmit={(event) => {
                      event.preventDefault();

                      void send({
                        type: "transfer",
                        fromId: transferFrom,
                        toId: transferTo,
                        amount: transferAmount,
                      });
                    }}
                  >
                    <fieldset
                      disabled={
                        !readyToCommand ||
                        live.activeAttack !== null
                      }
                      className={styles.form}
                    >
                      <label>
                        Source country

                        <select
                          value={transferFrom}
                          onChange={(event) => {
                            setTransferFrom(
                              event.target.value,
                            );

                            setTransferAmount(1);
                          }}
                        >
                          <option value="">
                            Choose source
                          </option>

                          {owned
                            .filter(
                              (country) =>
                                country.soldiers > 1,
                            )
                            .map((country) => (
                              <option
                                key={country.id}
                                value={country.id}
                              >
                                {country.name}
                                {" · "}
                                {country.soldiers}
                                {" soldiers"}
                              </option>
                            ))}
                        </select>
                      </label>

                      <label>
                        Destination country

                        <select
                          value={transferTo}
                          onChange={(event) =>
                            setTransferTo(
                              event.target.value,
                            )
                          }
                        >
                          <option value="">
                            Choose destination
                          </option>

                          {owned
                            .filter(
                              (country) =>
                                country.id !==
                                transferFrom,
                            )
                            .map((country) => (
                              <option
                                key={country.id}
                                value={country.id}
                              >
                                {country.name}
                              </option>
                            ))}
                        </select>
                      </label>

                      <label>
                        Soldiers to transfer

                        <input
                          type="number"
                          min={1}
                          max={Math.max(
                            1,
                            (selectedTransferSource
                              ?.soldiers ?? 1) - 1,
                          )}
                          step={1}
                          value={transferAmount}
                          onChange={(event) =>
                            setTransferAmount(
                              Number(
                                event.target.value,
                              ),
                            )
                          }
                        />
                      </label>

                      <button
                        type="submit"
                        disabled={
                          !transferFrom ||
                          !transferTo ||
                          transferFrom === transferTo
                        }
                      >
                        Transfer soldiers
                      </button>
                    </fieldset>
                  </form>
                </section>

                {live.pendingReinforcements > 0 &&
                  currentParticipant?.kind ===
                    "human" && (
                    <ReinforcementForm
                      key={
                        "reinforcements-" +
                        `${live.round}:` +
                        `${live.turnIndex}:` +
                        `${live.pendingReinforcements}`
                      }
                      state={live}
                      enabled={canAct}
                      onAllocate={(allocations) => {
                        void send({
                          type: "allocate",
                          allocations,
                        });
                      }}
                    />
                  )}
              </div>
            )}
          </div>

          <aside className={styles.sidebar}>
            <section className={styles.panel}>
              <h2>Campaign history</h2>

              <div className={styles.form}>
                <label>
                  Recorded board state

                  <select
                    value={replayRevision ?? ""}
                    disabled={
                      busy || playback !== null
                    }
                    onChange={(event) => {
                      dispatch({
                        type: "select-history",

                        revision:
                          event.target.value === ""
                            ? null
                            : Number(
                                event.target.value,
                              ),
                      });
                    }}
                  >
                    <option value="">
                      Live campaign
                    </option>

                    {events.map((event) => (
                      <option
                        key={
                          `history-option-${event.revision}`
                        }
                        value={event.revision}
                      >
                        #{event.revision}
                        {" · "}
                        {event.action}
                      </option>
                    ))}
                  </select>
                </label>

                <div className={styles.toolbar}>
                  <button
                    type="button"
                    disabled={
                      events.length === 0 ||
                      busy ||
                      playback !== null
                    }
                    onClick={() => {
                      dispatch({
                        type:
                          "toggle-history-playback",
                      });
                    }}
                  >
                    {replayPlaying
                      ? "Pause history"
                      : "Play history"}
                  </button>

                  <button
                    type="button"
                    disabled={
                      replayRevision === null
                    }
                    onClick={() => {
                      dispatch({
                        type: "select-history",
                        revision: null,
                      });
                    }}
                  >
                    Return to live
                  </button>
                </div>
              </div>

              {replayEvent && (
                <p className={styles.muted}>
                  {replayEvent.message}

                  {replayEvent.reason
                    ? ` Reason: ${replayEvent.reason}`
                    : ""}
                </p>
              )}
            </section>

            <section
              className={styles.panel}
              aria-label={
                "Battle and NPC decision log"
              }
            >
              <h2>Command reports</h2>

              <p className={styles.muted}>
                Saved actions, battle results,
                and NPC explanations.
              </p>

              <div
                className={styles.log}
                tabIndex={0}
                aria-label={
                  "Campaign event history"
                }
              >
                {[...events]
                  .reverse()
                  .slice(0, 60)
                  .map((event) => (
                    <article
                      key={
                        `report-${event.revision}`
                      }
                      className={styles.logEntry}
                    >
                      <strong>
                        EVENT {event.revision}
                        {" · "}

                        {event.actorId === "human"
                          ? "YOUR COMMAND"
                          : event.actorId === "system"
                            ? "CAMPAIGN"
                            : "NPC COMMAND"}
                      </strong>

                      <p>{event.message}</p>

                      {event.reason && (
                        <p
                          className={styles.reason}
                        >
                          Reason: {event.reason}
                        </p>
                      )}
                    </article>
                  ))}
              </div>
            </section>
          </aside>
        </div>
      </div>
    </main>
  );
}